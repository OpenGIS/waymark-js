{
  "name": "waymark-js",
  "version": "2.0.0-a6",
  "type": "module",
  "module": "./dist/waymark.js",
  "exports": {
    ".": {
      "import": "./dist/waymark.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --config vite.config.dev.js --host 0.0.0.0",
    "dev:browser-tests": "vite --config vite.config.dev.js --host 127.0.0.1 --port 4173 --strictPort",
    "build": "vite build --config vite.config.lib.js",
    "check:dist": "node scripts/check-dist.mjs",
    "check:llms": "node scripts/llms-full.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:contract": "node scripts/check-doc-test-contract.mjs",
    "api:contract": "node scripts/generate-api-contract.mjs",
    "docs:api-sync": "npm run api:contract && node scripts/check-api-doc-sync.mjs",
    "docs:sync": "node scripts/llms-full.mjs && npm run docs:contract && npm run docs:api-sync",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:ci": "npm run format:check && npm run check:llms && npm run docs:sync && npm run build && npm run check:dist && npm test && npm run test:browser"
  },
  "peerDependencies": {
    "maplibre-gl": "^6.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "fs-extra": "^11.3.0",
    "glob": "^11.0.0",
    "jsdom": "^29.1.1",
    "maplibre-gl": "^6.7.0",
    "prettier": "^3.8.4",
    "vite": "^8.0.12",
    "vitest": "^4.1.9"
  }
}
