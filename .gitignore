# Transient SwiftShader pin, written for screenshots runs and removed on
# teardown (see tests/browser/global-setup.js)
SwiftShader.ini

# Local scratch files
TASK.md
NOTES.md
docs/.generated

# Documentation site build outputs (the published llms copies under
# docs/public/ are tracked in version control)
docs/public/screenshots/
docs/public/waymark-logo.svg
docs/server/assets/docs-pages/

# The v1 docs archive serves its own library dist — re-include it (the bare
# `dist` rule above would otherwise exclude it from version control)
!docs/public/v1/dist/
!docs/public/v1/dist/**
