# Copy to `docs/.env` (gitignored) to override the docs site's deployment
# targets. Values are read when the dev server starts or when the site is
# generated (`npm run docs:dev` / `npm run docs:generate`) — restart or
# regenerate after changing them.

# Canonical site URL. Its pathname also becomes the asset base path, e.g.
# https://opengis.github.io/Waymark-JS/ serves under /Waymark-JS/.
# Unset: root path (/) with a https://www.ogis.org/waymark-js canonical default.
# NUXT_PUBLIC_PRODUCTION_URL=https://opengis.github.io/Waymark-JS/

# Hosted OpenGIS branding assets — the theme stylesheet and the background-map
# module the docs pages link. Unset: https://www.ogis.org/branding
# NUXT_PUBLIC_BRANDING_URL=https://www.ogis.org/branding
